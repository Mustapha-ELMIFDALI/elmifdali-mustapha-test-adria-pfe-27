enum TransactionType {
    PAYMENT
    TRANSFER_OUT
    TRANSFER_IN
}

type Transaction {
    id: ID!
    accountId: ID!
    type: TransactionType!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
}

input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
    currency: String!
}

type Query {
    transactions: [Transaction!]!
    transaction(id: ID!): Transaction!
    transactionsByAccount(accountId: ID!): [Transaction!]!
}

type Mutation {
    createTransaction(input: CreateTransactionInput!): Transaction!
    transfer(input: TransferInput!): [Transaction!]!
}
